# Configuración de Pact por entorno.
# Copia este fichero y ajusta los valores. Todos tienen un default razonable,
# así que no es obligatorio definir ninguno para arrancar.

# --- Base de datos local ---
# Solo se admite SQLite. MariaDB/MySQL es destino de sincronización, no BD local.
# Si no se define, va a <directorio de datos>/pact.db (ver PACT_DATA_DIR).
DATABASE_URL=sqlite:pact.db

# --- Bóveda ---
# Ruta del contenedor .pcty. Si no se define, va a <directorio de datos>/pact.pcty.
PACT_VAULT_PATH=pact.pcty

# --- Red ---
# Interfaz y puerto de escucha. 127.0.0.1 (loopback) es el default y el
# recomendado: el servidor guarda una bóveda de contraseñas, no lo expongas a
# la red sin un reverse proxy con TLS delante.
PACT_LISTEN_ADDR=127.0.0.1:8002

# Orígenes CORS adicionales, separados por comas (opcional).
# El servidor ya permite por defecto los orígenes de Tauri y de `make dev`.
# NO se admite `*`: activaría CORS permisivo.
# PACT_CORS_ORIGIN=https://pact.ejemplo.com

# --- Rutas ---
# Directorio de datos de Pact (BD, .pcty por defecto y machine-id de reserva).
# Si no se define se usa el directorio de datos del usuario
# (XDG_DATA_HOME/pact, %APPDATA%\pact, ~/Library/Application Support/pact).
# Necesario cuando el directorio de trabajo no sea escribible: en el AppImage es
# el montaje squashfs de solo lectura, y sin esto el servidor no arranca.
# PACT_DATA_DIR=/var/lib/pact

# --- Rendimiento ---
# Segundos entre limpiezas de los rate limiters (default 300).
# PACT_LIMITER_CLEANUP_SECS=300
# Segundos entre guardados diferidos de la bóveda (default 2).
# PACT_FLUSH_INTERVAL_SECS=2

# --- Diagnóstico ---
# Por defecto el servidor usa `info`. Súbelo solo para depurar.
# RUST_LOG=pact_server=debug,tower_http=warn